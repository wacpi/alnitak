{
  "agents": {
    "sisyphus": {
      "model": "anthropic/claude-3.5-sonnet",
      "description": "主要编程代理 - 处理复杂开发任务"
    },
    "oracle": {
      "model": "anthropic/claude-3.5-haiku", 
      "description": "快速回答和指导"
    },
    "explore": {
      "model": "anthropic/claude-3.5-haiku",
      "description": "代码探索和分析"
    },
    "librarian": {
      "model": "anthropic/claude-3.5-haiku",
      "description": "文档和研究"
    },
    "multimodal-looker": {
      "model": "google/claude-sonnet-4-5",
      "description": "多模态视觉分析"
    },
    "frontend-ui-ux-engineer": {
      "model": "google/claude-sonnet-4-5",
      "description": "前端UI/UX开发"
    }
  },
  "hooks": {
    "before_run": ["auto_mcp"],
    "after_run": ["save_history"]
  },
  "mcp": {
    "auto_enable": true
  },
  "google_auth": false
}